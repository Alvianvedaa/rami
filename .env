# =====================================================================
# Rami Coffee & Eatery — Environment Variables
# ---------------------------------------------------------------------
# Vercel : Project > Settings > Environment Variables
#          Paste seluruh isi file ini ke kolom "Key" (Vercel otomatis
#          memecahnya per baris), ganti semua nilai "ISI_...", lalu Save.
#          Setelah itu WAJIB Redeploy.
# Lokal  : salin jadi file ".env" (jangan pernah di-commit ke Git).
# =====================================================================

# ---------- 1. SUPABASE (database & login admin) ----------
# Supabase > Project Settings > API
SUPABASE_URL=ISI_https://xxxxxxxx.supabase.co
# "service_role" / secret key  -> RAHASIA, hanya dipakai di server
SUPABASE_SERVICE_ROLE_KEY=ISI_service_role_key
# "anon" / publishable key (untuk login admin)
SUPABASE_ANON_KEY=ISI_anon_key

# ---------- 2. OLSERA POS ----------
# false = kirim ke Olsera sungguhan. true/kosong = simulasi (MOCK).
MOCK_MODE=false
OLSERA_API_BASE_URL=https://api-open.olsera.co.id
OLSERA_APP_ID=ISI_app_id_dari_olsera
OLSERA_SECRET_KEY=ISI_secret_key_dari_olsera
# ID toko Olsera
OLSERA_STORE_ID=733
# ID (angka) tipe pelanggan di Olsera, mis. tipe "Online / Web"
OLSERA_CUSTOMER_TYPE_ID=ISI_angka_id_tipe_pelanggan
# Nomor cadangan untuk pesanan tanpa nomor WA pelanggan
OLSERA_DEFAULT_PHONE=ISI_nomor_telepon_toko

# ---------- 3. GOPAY / QRIS DINAMIS (via Midtrans) ----------
# Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=ISI_server_key_midtrans
MIDTRANS_CLIENT_KEY=ISI_client_key_midtrans
# false = sandbox (uji coba), true = produksi (uang sungguhan).
# Harus cocok dengan jenis key di atas.
MIDTRANS_IS_PRODUCTION=false

# ---------- 4. LAINNYA ----------
# Domain storefront yang boleh memanggil API (isi * bila satu domain yang sama)
FRONTEND_ORIGIN=*

# JANGAN diisi di produksi. Mengaktifkan tombol "simulasi bayar" yang
# bisa menandai pesanan lunas tanpa membayar.
# ALLOW_SIMULATE_PAY=true
