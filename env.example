# =============================================================
# Contoh Environment Variables — Rami Coffee & Eatery
# Salin ke Vercel: Project -> Settings -> Environment Variables
# =============================================================

# --- Login Admin ---
# Kalau tidak diisi, PIN bawaan di kode adalah 220901.
ADMIN_PIN=220901
ADMIN_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# --- Database Supabase (Postgres) ---
# Ambil dari Supabase: Project Settings -> Database -> Connection string
# -> pilih tab "Connection pooling" (bukan "Direct connection") supaya
# cocok dipakai di lingkungan serverless seperti Vercel.
# Bentuknya kira-kira:
# postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Kalau env ini kosong, aplikasi otomatis pakai penyimpanan sementara
# di memori (data hilang saat function "tertidur").
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Olsera POS (opsional) ---
MOCK_MODE=true
OLSERA_API_BASE_URL=
OLSERA_API_KEY=
OLSERA_OUTLET_ID=
